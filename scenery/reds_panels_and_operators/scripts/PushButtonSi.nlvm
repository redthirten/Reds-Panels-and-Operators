public class PushButtonSi extends PushButton{
	public PushButtonSi(){
		SCRIPT_NAME = "PushButtonSi";			// Script name for debugging
		BUTTON_TRAVEL_DIST = 0.0049591f;		// Distance, in meters, the button will travel to be fully "pressed"
		BUTTON_INTERACTION_RADIUS = 0.03f;		// Radius, in meters, of the InteractionObject detection sphere
	}
}