public class EStopButtonAB extends EStopButton{
	public EStopButtonAB(){
		SCRIPT_NAME = "EStopButtonAB";			// Script name for debugging
		BUTTON_INTERACTION_RADIUS = 0.05f;		// Radius, in meters, of the InteractionObject detection sphere
	}
}