import util.SceneObjectTools;

public class ElectricalPanel extends TexturedSceneObject{
	protected String MOUNT_ELEMENT_NAME = "mount";		// Name of the mount element in the SCO/model
	protected String CONDUIT_ELEMENT_NAME = "pipe";		// Name of the conduit element in the SCO/model

	ElectricalPanel(){
		SCRIPT_NAME = "ElectricalPanel";	// Script name for debugging
		MAIN_ELEMENT_NAME = "panel";		// Name of the main element in the SCO/model
	}
	
	public final bool onInit(){ // Addl init
		// Run parent init
		bool superInit = super.onInit();
		
		// Hide mount if configured
		doElemHideIfTrue(
			getSco(),
			SceneObjectTools.getElementForName(getSco(), MOUNT_ELEMENT_NAME, SCRIPT_NAME),
			"hide_mount"
		);
		// Hide pipe if configured
		doElemHideIfTrue(
			getSco(),
			SceneObjectTools.getElementForName(getSco(), CONDUIT_ELEMENT_NAME, SCRIPT_NAME),
			"hide_pipe"
		);
		
		return superInit;
	}
}