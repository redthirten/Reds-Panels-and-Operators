import com.nolimitscoaster.SceneObject;

public final class EStopButtonSiNoLight extends EStopButtonSi{
	EStopButtonSiNoLight(){
		BUTTON_HAS_LIGHT = false;			// True if the button has a pilot light
	}

	protected final int getFuncFromScoParams(SceneObject sco){
		/* Get Function from SCO Parameters
			Returns the proper function number based on the "function" parameter enumeration.
		*/
		if (sco.getIntegerParameter("function") == null) return 0;

		int funcVal = sco.getIntegerParameter("function").intValue();
		switch (funcVal){
			case 1: // E-Stop (Simple)
				return F_ESTOP_SIMPLE;
			case 2: // E-Stop (Advanced)
				return F_ESTOP_ADVANCED;
		}
		return funcVal;
	}
}