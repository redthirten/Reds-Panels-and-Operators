import com.nolimitscoaster.SceneObject;
import com.nolimitscoaster.SceneObjectElement;

import util.SceneObjectTools;

public class EStopButtonSi extends EStopButton{
	private String COLLAR_ELEMENT_NAME = "collar";	// Name of the protective collar element in the SCO/model

	public final bool onInit(){
		super.SCRIPT_NAME = "EStopButtonSi";		// Script name for debugging
		super.BUTTON_ELEMENT_NAME = "estop_button";	// Name of the button element in the SCO/model
		super.BUTTON_TRAVEL_TIME = 0.2f;			// Time, in seconds, for the button to travel in and out ("speed")
		super.BUTTON_TRAVEL_DIST = 0.00396f;	    // Distance, in meters, the button will travel to be fully "pressed"
		
		// Run the rest of the init code in EStopButton
		if (!super.onInit()) return false;

		// Handle protective collar
		SceneObject sco = SceneObjectTools.getSceneObjectForEntityId(
			sim,
			getParentEntityId(),
			SCRIPT_NAME
		);
		SceneObjectElement collar = SceneObjectTools.getElementForName(sco, COLLAR_ELEMENT_NAME, SCRIPT_NAME);
		SceneObjectElement placard = SceneObjectTools.getElementForName(sco, PLACARD_ELEMENT_NAME, SCRIPT_NAME);
		if (sco.getBooleanParameter("show_collar").boolValue()){
			collar.setVisible(true);
			placard.setVisible(false);
		}
		else{
			collar.setVisible(false);
		}

		return true;
	}
}