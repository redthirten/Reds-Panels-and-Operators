public class PushButtonSiemens extends PushButton{
	public final bool onInit(){
		super.SCRIPT_NAME = "PushButtonSiemens";	// Script name for debugging
		super.BUTTON_TRAVEL_DIST = 0.0049591f;		// Distance, in meters, the button will travel to be fully "pressed"
		super.BUTTON_INTERACTION_RADIUS = 0.03f;	// Radius, in meters, of the InteractionObject detection sphere
		
		return super.onInit();						// Run the rest of the init code in PushButton
	}
}