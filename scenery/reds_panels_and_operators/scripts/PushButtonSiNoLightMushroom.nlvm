public class PushButtonSiNoLightMushroom extends PushButtonSiNoLight{
	public PushButtonSiNoLightMushroom(){
		SCRIPT_NAME = "PushButtonSiNoLightMushroom";	// Script name for debugging
		BUTTON_INTERACTION_RADIUS = 0.05f;				// Radius, in meters, of the InteractionObject detection sphere
	}
}