public class PushButtonSiNoLightFlat extends PushButtonSiNoLight{
	public PushButtonSiNoLightFlat(){
		SCRIPT_NAME = "PushButtonSiNoLightFlat";	// Script name for debugging
		BUTTON_TRAVEL_DIST = 0.0033f;				// Distance, in meters, the button will travel to be fully "pressed"
	}
}