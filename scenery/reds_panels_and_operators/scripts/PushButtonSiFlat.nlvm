public final class PushButtonSiFlat extends PushButtonSi{
	PushButtonSiFlat(){
		SCRIPT_NAME = "PushButtonSiFlat";		// Script name for debugging
		BUTTON_TRAVEL_DIST = 0.0033f;			// Distance, in meters, the button will travel to be fully "pressed"
	}
}