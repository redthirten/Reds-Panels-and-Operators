import com.nolimitscoaster.SceneObjectElement;

import util.SceneObjectTools;

public final class MainPanel extends TexturedSceneObject{
	private static final String AUDIO_PANEL_ELEMENT_NAME = "audio_panel";	// Name of the audio panel element in the SCO/model

	MainPanel(){
		SCRIPT_NAME = "MainPanel";		// Script name for debugging
		MAIN_ELEMENT_NAME = "panel";	// Name of the main element in the SCO/model
	}
	
	public final bool onInit(){ // Addl init
		// Run parent init
		bool superInit = super.onInit();
		
		// Set audio panel visibility & texture based on parameters
		SceneObjectElement audioPanelElem = getSco().getElementForName(AUDIO_PANEL_ELEMENT_NAME);
		if (audioPanelElem == null){
			// Some main panels don't have audio panels, so return early if so
			return superInit;
		}
		bool panelHidden = doElemHideIfTrue(
			getSco(),
			audioPanelElem,
			"hide_audio_panel"
		);
		if (!panelHidden){
			setTextureFromScoParam(getSco(), audioPanelElem);
		}
		
		return superInit;
	}
}