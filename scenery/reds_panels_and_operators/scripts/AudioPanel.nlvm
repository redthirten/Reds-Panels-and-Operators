import util.SceneObjectTools;

public final class AudioPanel extends TexturedSceneObject{
	private static final String MOUNT_ELEMENT_NAME = "mount";	// Name of the mount element in the SCO/model

	AudioPanel(){
		SCRIPT_NAME = "AudioPanel";		// Script name for debugging
		MAIN_ELEMENT_NAME = "panel";	// Name of the main element in the SCO/model
	}
	
	public final bool onInit(){ // Addl init
		// Run parent init
		bool superInit = super.onInit();

		// Hide mount if configured
		doElemHideIfTrue(
			getSco(),
			SceneObjectTools.getElementForName(getSco(), MOUNT_ELEMENT_NAME, SCRIPT_NAME),
			"hide_mount"
		);
		
		return superInit;
	}
}