public class PushButtonABMushroom extends PushButtonAB{
	public PushButtonABMushroom(){
		SCRIPT_NAME = "PushButtonABMushroom";	// Script name for debugging
		BUTTON_INTERACTION_RADIUS = 0.05f;		// Radius, in meters, of the InteractionObject detection sphere
	}
}