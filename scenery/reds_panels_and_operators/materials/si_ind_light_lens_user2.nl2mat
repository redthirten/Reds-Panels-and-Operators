<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Siemens indicator light lens that is recolorable using the User 2 custom defined color.</description>
    <preview>textures/si_button/button_side_on_color.jpg</preview>
    <renderpass>
      <shadercore>Roughness = Tex3;

Emission = Mul(Tex1, entity2); // Set emission to texture/custom color combination

Result = Mul(Tex0, entity2); // Set color output to texture/custom color combination</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <reflection fresnelconst="0" fresnelvar="0"/>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/si_pilot/pilot_off_color.jpg</map>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <animmap frequency="2">
          <map>intern:data/textures/fx/black.png</map>
          <map>textures/si_pilot/pilot_on_color.jpg</map>
        </animmap>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/Plastic003/Plastic003_Normal.jpg</map>
        <bump mode="normalgloss"/>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/Plastic003/Plastic003_Roughness.jpg</map>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>