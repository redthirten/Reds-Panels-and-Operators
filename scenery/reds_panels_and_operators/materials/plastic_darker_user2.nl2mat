<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Matte plastic that is recolorable using the User 2 custom defined color, and is 75% darker.</description>
    <renderpass>
      <shadercore>Result = Mul(Entity2, 0.25);</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>0.75</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="lighting"/>
    </renderpass>
  </material>
</root>