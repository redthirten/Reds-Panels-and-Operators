<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>A brushed metal, orange peel, or rusty metal texture, with normal map, roughness, and User 0 custom defined color.</description>
    <preview>textures/metal_11/Metal011_2K_Color.jpg</preview>
    <renderpass>
      <shadercore>Result = Mul(tex0, entity0);
Metallic = 0.15;
Roughness = Mul(tex2,2);</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0.15</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <reflection bump="true" fresnelconst="0" fresnelvar="0"/>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <animmap frequency="0">
          <map>textures/metal_11/Metal011_2K_Color.jpg</map>
          <map>intern:data/textures/fx/white.png</map>
          <map>textures/Metal024/Metal024_2K_Color.jpg</map>
        </animmap>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <animmap frequency="0">
          <map>textures/metal_11/Metal011_2K_Normal.jpg</map>
          <map>textures/metal_orange_peel_normal.jpg</map>
          <map>textures/Metal024/Metal024_2K_Normal.jpg</map>
        </animmap>
        <bump mode="normalgloss"/>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <animmap frequency="0">
          <map>textures/metal_11/Metal011_2K_Roughness.jpg</map>
          <map>textures/metal_11/Metal011_2K_Roughness.jpg</map>
          <map>textures/Metal024/Metal024_2K_Roughness.jpg</map>
        </animmap>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
    <footstepsounds>
      <footstepsound>intern:data/sounds/walk/metal1.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal2.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal3.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal4.wav</footstepsound>
    </footstepsounds>
  </material>
</root>