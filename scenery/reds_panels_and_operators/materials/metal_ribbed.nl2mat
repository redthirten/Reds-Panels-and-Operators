<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>A brushed metal texture, with ribbed height map, metalness, and roughness.</description>
    <preview>textures/metal_11/Metal011_2K_Color.jpg</preview>
    <renderpass>
      <shadercore>Result = tex0;
Roughness = tex2;
Metallic = 0.4;</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="0.623529" g="0.639216" b="0.654902"/>
        <metallic>1</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <reflection bump="true" fresnelconst="0" fresnelvar="0"/>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/metal_11/Metal011_2K_Color.jpg</map>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/ribbed_height.png</map>
        <bump mode="heightgloss" heightscale="30"/>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/metal_11/Metal011_2K_Roughness.jpg</map>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
    <footstepsounds>
      <footstepsound>intern:data/sounds/walk/metal1.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal2.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal3.wav</footstepsound>
      <footstepsound>intern:data/sounds/walk/metal4.wav</footstepsound>
    </footstepsounds>
  </material>
</root>