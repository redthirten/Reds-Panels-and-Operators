<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Siemens opaque button material that is recolorable using the User 2 custom defined color.</description>
    <preview>textures/si_button/estop_normal.jpg</preview>
    <renderpass>
      <shadercore>Roughness = Tex0;
Result = Entity2;</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/Plastic003/Plastic003_Roughness.jpg</map>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/si_button/estop_normal.jpg</map>
        <bump mode="normalgloss"/>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>