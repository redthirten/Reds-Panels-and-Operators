<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Custom label texture for the PLC Controller model.</description>
    <preview>textures/ab_plc_controller/lsr13.png</preview>
    <renderpass>
      <transparency mode="cutout"/>
      <alphatest function="ge128"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="lighting"/>
      <texunit>
        <map>textures/ab_plc_controller/lsr13.png</map>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>