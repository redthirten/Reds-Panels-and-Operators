<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Matte, black colored plastic w/ ribbed height map.</description>
    <preview>intern:data/textures/fx/black.png</preview>
    <renderpass>
      <shadercore>Roughness = 0.75;</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="0.117647" g="0.109804" b="0.113725"/>
        <metallic>0</metallic>
        <roughness>0.75</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/ribbed_height.png</map>
        <bump mode="heightgloss" heightscale="30"/>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>