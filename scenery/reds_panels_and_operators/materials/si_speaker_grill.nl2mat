<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Reflective, black colored, plastic with Siemens speaker grill normal map</description>
    <preview>textures/si_speaker/speaker_normal.png</preview>
    <renderpass>
      <shadercore>Result = Color;</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="0.117647" g="0.109804" b="0.113725"/>
        <metallic>0</metallic>
        <roughness>0.5</roughness>
      </pbrmetallicworkflow>
      <reflection fresnelconst="0" fresnelvar="0"/>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/si_speaker/speaker_normal.png</map>
        <bump mode="normalgloss"/>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>