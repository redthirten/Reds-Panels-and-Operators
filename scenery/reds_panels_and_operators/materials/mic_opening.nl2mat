<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>Mic opening texture (black plastic + custom normal map).</description>
    <preview>textures/factory_wall/factory_wall_nor_1k.jpg</preview>
    <renderpass>
      <shadercore>Result = tex0;</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="bumplighting"/>
      <texunit>
        <map>textures/Metal_Galvanized_001/Metal_Galvanized_001_roughness.jpg</map>
        <tcgen mode="base"/>
      </texunit>
      <texunit>
        <map>textures/factory_wall/factory_wall_nor_1k.jpg</map>
        <bump mode="normalgloss"/>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>