<?xml version="1.0" encoding="UTF-8"?>
<root>
  <material>
    <description>All possible labels, listed in animation format.</description>
    <preview>Operator 1.png</preview>
    <renderpass>
      <shadercore>Result = Lerp(Tex0, Entity0, Entity1);</shadercore>
      <transparency mode="opaque"/>
      <linearshading/>
      <pbrmetallicworkflow>
        <basecolor r="1" g="1" b="1"/>
        <metallic>0</metallic>
        <roughness>1</roughness>
      </pbrmetallicworkflow>
      <rgbgen mode="lighting"/>
      <texunit>
        <entity/>
        <wrap mode="clamp"/>
        <forcelineargray/>
        <tcgen mode="base"/>
      </texunit>
    </renderpass>
  </material>
</root>