<?xml version="1.0" encoding="UTF-8"?>
<root>
  <sceneobject>
    <model path="models/si/text_panel_tdi.dae"/>
    <param basescalex="2"/>
    <param basescaley="2"/>
    <param basescalez="2"/>
    <usercolor>
      <label>Backlight (Black = Off)</label>
      <index>0</index>
      <defaultcolor r="0.431373" g="0.843137" b="0.996078"/>
    </usercolor>
    <usercolor>
      <label>Housing</label>
      <index>1</index>
      <defaultcolor r="0.533333" g="0.556863" b="0.627451"/>
    </usercolor>
    <usertexture>
      <label>Panel Screen:</label>
      <description>Panel screen image to use.</description>
      <defaultpath>materials/textures/si_text_panel/panel_screen.png</defaultpath>
    </usertexture>
    <scriptparameter>
      <type>int</type>
      <defaultvalue>0</defaultvalue>
      <enums>Coming Soon!</enums>
      <id>function</id>
      <label>Function:</label>
    </scriptparameter>
    <materialpath name="glass">materials/glass_dirty_transparent.nl2mat</materialpath>
    <materialpath name="housing">materials/plastic_user1.nl2mat</materialpath>
    <materialpath name="panel_face">materials/si_text_panel_face.nl2mat</materialpath>
    <materialpath name="panel_screen">materials/si_text_panel_screen.nl2mat</materialpath>
  </sceneobject>
</root>